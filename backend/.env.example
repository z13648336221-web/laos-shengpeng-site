PORT=3001
NODE_ENV=production
DB_PATH=./database/shengpeng.db

# 安全配置 - 请使用强随机密钥
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_secure_session_secret_here
COOKIE_SECRET=your_secure_cookie_secret_here

# 病毒扫描配置
VIRUS_SCAN_ENABLED=false
VIRUS_SCAN_ENGINE=none
# CLAMAV_COMMAND=clamdscan
# CLAMAV_TIMEOUT=30000
# WIN_DEFENDER_COMMAND=C:\\Program Files\\Windows Defender\\MpCmdRun.exe
# WIN_DEFENDER_SCAN_TYPE=1